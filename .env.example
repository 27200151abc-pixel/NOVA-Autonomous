# OpenAI-compatible endpoint. Leave blank to run health checks without inference.
NOVA_BASE_URL=
NOVA_API_KEY=
NOVA_MODEL=
NOVA_TIMEOUT_SECONDS=60
NOVA_DATABASE_PATH=./nova_memory.sqlite3
NOVA_MAX_HISTORY_MESSAGES=20
NOVA_CORS_ORIGINS=http://localhost:5173
NOVA_POLICY_PATH=./nova/policy.json

# Required to unlock owner-only policy, memory, and approval endpoints.
# Generate a long random secret and keep it private.

# Directory NOVA may access through its built-in file tools.
NOVA_WORKSPACE_ROOT=./workspace
# Required for owner-only API routes and approval decisions.
NOVA_OWNER_TOKEN=
